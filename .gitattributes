# 默认：文本文件按提交时的原样保存（不自动转 CRLF），checkout 时也不转换。
# 解决 commit 时反复出现的 "LF will be replaced by CRLF" 警告。
* text=auto eol=lf

# 明确文本类按 LF（跨平台一致）
*.kt     text eol=lf
*.kts    text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.gradle text eol=lf
*.pro     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.properties text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf
*.toml   text eol=lf

# Windows 专属脚本保持 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制：不做任何转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.svg    text eol=lf
*.so     binary
*.aar    binary
*.jar    binary
*.zip    binary
*.gz     binary
*.jks    binary
*.keystore binary
*.bin    binary
*.ttf    binary
*.otf    binary
*.ttc    binary

# ===== GitHub 语言统计修正 =====
# 将 docs-site/（VitePress 打包成品）和 site/docs-site/ 标记为 vendored，
# 不计入语言统计，避免 61 个 HTML 文件导致仓库被误判为 HTML 静态站点。
docs-site/** linguist-vendored
site/docs-site/** linguist-vendored
# 压缩后的前端资产也忽略
*.min.js   linguist-vendored
*.min.css  linguist-vendored
